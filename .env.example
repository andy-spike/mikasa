# Copy to .env.local and fill in. Never commit .env.local.
# Required at boot: missing auth vars fail startup (see lib/auth.ts).

# --- Auth (Better Auth + Google OAuth, ADR 0003) ---
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Database (Neon Postgres, ADR 0004) ---
# Two branches: dev for daily work, main for production. The db:*
# commands pick between them; the app itself runs on dev locally.
# Promotion is `db:migrate:main` after dev is verified.
DATABASE_URL_DEV=
DATABASE_URL_MAIN=

# --- Models (all calls via OpenRouter, ADR 0002) ---
# Chat, generation, tutoring plus the embeddings endpoint.
OPENROUTER_API_KEY=

# --- Web search (Grounding + Tutor searchWeb) ---
FIRECRAWL_API_KEY=

# --- Neon workflow (branch management via CLI, not read by the app) ---
NEON_PROJECT_ID=
